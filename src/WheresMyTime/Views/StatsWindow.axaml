<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WheresMyTime.ViewModels"
        xmlns:views="using:WheresMyTime.Views"
        x:Class="WheresMyTime.Views.StatsWindow"
        x:DataType="vm:StatsViewModel"
        Title="Stats — Where's my time"
        Width="600" Height="700" MinWidth="420" MinHeight="420"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <Style Selector="TabItem">
      <Setter Property="FontSize" Value="15" />
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="Padding" Value="0,0,20,0" />
    </Style>
    <Style Selector="Button.legend">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="6,3" />
      <Setter Property="CornerRadius" Value="6" />
    </Style>
    <Style Selector="Button.legend.active">
      <Setter Property="Background" Value="{DynamicResource CardBrush}" />
    </Style>
    <Style Selector="Button.legend.active TextBlock.name">
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.legend.dimmed">
      <Setter Property="Opacity" Value="0.45" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- Legend shared by both charts; clicking an entry highlights that activity. -->
    <ItemsPanelTemplate x:Key="LegendPanel">
      <WrapPanel ItemSpacing="4" LineSpacing="2" />
    </ItemsPanelTemplate>
    <DataTemplate x:Key="LegendItemTemplate" x:DataType="vm:LegendItem">
      <Button Classes="legend" Classes.active="{Binding IsActive}" Classes.dimmed="{Binding IsDimmed}"
              Command="{Binding $parent[Window].((vm:StatsViewModel)DataContext).ToggleHighlightCommand}"
              CommandParameter="{Binding}" ToolTip.Tip="Click to highlight">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <views:SeriesSwatch Slot="{Binding Slot}" Width="10" Height="10" VerticalAlignment="Center" />
          <TextBlock Classes="small name" Text="{Binding Name}" />
          <TextBlock Classes="small muted" Text="{Binding TotalText}" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <DockPanel Margin="20,16,20,16">

    <!-- The date range scopes both tabs. -->
    <StackPanel DockPanel.Dock="Top" Spacing="12">
      <WrapPanel ItemSpacing="6" LineSpacing="6">
        <Button Content="Today" Command="{Binding PresetCommand}" CommandParameter="Today" />
        <Button Content="Yesterday" Command="{Binding PresetCommand}" CommandParameter="Yesterday" />
        <Button Content="This week" Command="{Binding PresetCommand}" CommandParameter="ThisWeek" />
        <Button Content="Last week" Command="{Binding PresetCommand}" CommandParameter="LastWeek" />
        <Button Content="This month" Command="{Binding PresetCommand}" CommandParameter="ThisMonth" />
        <Button Content="Last month" Command="{Binding PresetCommand}" CommandParameter="LastMonth" />
        <Button Content="Last 12 weeks" Command="{Binding PresetCommand}" CommandParameter="Last12Weeks" />
        <Button Content="This year" Command="{Binding PresetCommand}" CommandParameter="ThisYear" />
      </WrapPanel>

      <StackPanel Orientation="Horizontal" Spacing="8">
        <CalendarDatePicker SelectedDate="{Binding From}" Width="140"
                            SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
        <TextBlock Text="to" VerticalAlignment="Center" />
        <CalendarDatePicker SelectedDate="{Binding To}" Width="140"
                            SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
      </StackPanel>

      <Grid ColumnDefinitions="*,Auto">
        <StackPanel>
          <TextBlock Text="{Binding TotalText}" FontSize="28" FontWeight="SemiBold" />
          <TextBlock Classes="muted" Text="{Binding SummaryText}" TextWrapping="Wrap" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="6" VerticalAlignment="Bottom">
          <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
            <Button Content="Copy" Command="{Binding CopyCommand}" ToolTip.Tip="Copy the stats as text" />
            <Button Content="Export CSV" Command="{Binding ExportCommand}" ToolTip.Tip="Save the entries in this range as CSV" />
          </StackPanel>
          <TextBlock Classes="muted small" Text="{Binding StatusText}" HorizontalAlignment="Right" />
        </StackPanel>
      </Grid>
    </StackPanel>

    <TabControl Margin="0,8,0,0" Padding="0">

      <TabItem Header="Summary">
        <DockPanel Margin="0,8,0,0">
          <CheckBox DockPanel.Dock="Top" Content="Show details" IsChecked="{Binding ShowDetails}"
                    HorizontalAlignment="Right" IsVisible="{Binding HasData}" />
          <ScrollViewer Margin="0,4,0,0">
            <!-- Right margin keeps the percentages clear of the scrollbar. -->
            <StackPanel Spacing="20" Margin="0,0,16,0">
              <TextBlock Classes="muted" Text="No entries in this range." IsVisible="{Binding !HasData}"
                         HorizontalAlignment="Center" Margin="0,20" />

              <ItemsControl ItemsSource="{Binding Activities}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <StackPanel Spacing="14" />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ActivityRow">
                    <StackPanel Spacing="4">
                      <Grid ColumnDefinitions="*,Auto,64">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Classes="tabular" Text="{Binding TotalText}" />
                        <TextBlock Grid.Column="2" Classes="muted tabular" Text="{Binding PercentText}" TextAlignment="Right" />
                      </Grid>
                      <ProgressBar Value="{Binding Percent}" Maximum="100" />
                      <ItemsControl ItemsSource="{Binding Details}" Margin="16,2,0,0"
                                    IsVisible="{Binding $parent[Window].((vm:StatsViewModel)DataContext).ShowDetails}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="vm:DetailRow">
                            <Grid ColumnDefinitions="*,Auto,64">
                              <TextBlock Classes="muted small" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                              <TextBlock Grid.Column="1" Classes="muted small tabular" Text="{Binding TotalText}" />
                            </Grid>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel Spacing="8" IsVisible="{Binding HasData}">
                <TextBlock Text="By day" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Days}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="6" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayRow">
                      <Grid ColumnDefinitions="130,*,70">
                        <TextBlock Classes="tabular" Text="{Binding Label}" VerticalAlignment="Center" />
                        <ProgressBar Grid.Column="1" Value="{Binding Percent}" Maximum="100" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Classes="tabular" Text="{Binding TotalText}" TextAlignment="Right" />
                      </Grid>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </TabItem>

      <TabItem Header="Breakdown">
        <DockPanel Margin="0,12,0,0">
          <TextBlock DockPanel.Dock="Top" Text="{Binding ChartTitle}" FontWeight="SemiBold" IsVisible="{Binding HasData}" />
          <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Legend}" IsVisible="{Binding HasLegend}" Margin="-6,6,0,4"
                        ItemsPanel="{StaticResource LegendPanel}" ItemTemplate="{StaticResource LegendItemTemplate}" />
          <TextBlock DockPanel.Dock="Top" Classes="muted" Text="No entries in this range." IsVisible="{Binding !HasData}"
                     HorizontalAlignment="Center" Margin="0,20" />
          <views:StackedColumnChart Data="{Binding Chart}" Highlighted="{Binding Highlighted, Mode=TwoWay}"
                                    IsVisible="{Binding HasData}" MinHeight="220" Margin="0,8,0,0"
                                    AutomationProperties.Name="Time per day by activity. Use the arrow keys to read each column." />
        </DockPanel>
      </TabItem>

      <TabItem Header="Trend">
        <DockPanel Margin="0,12,0,0">
          <TextBlock DockPanel.Dock="Top" Text="{Binding TrendTitle}" FontWeight="SemiBold" IsVisible="{Binding HasData}" />
          <TextBlock DockPanel.Dock="Top" Classes="muted small" Text="{Binding TrendHint}" IsVisible="{Binding HasLegend}"
                     TextWrapping="Wrap" Margin="0,2,0,0" />
          <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Legend}" IsVisible="{Binding HasLegend}" Margin="-6,6,0,4"
                        ItemsPanel="{StaticResource LegendPanel}" ItemTemplate="{StaticResource LegendItemTemplate}" />
          <TextBlock DockPanel.Dock="Top" Classes="muted" Text="No entries in this range." IsVisible="{Binding !HasData}"
                     HorizontalAlignment="Center" Margin="0,20" />
          <views:TrendLineChart Data="{Binding Chart}" Highlighted="{Binding Highlighted, Mode=TwoWay}"
                                IsVisible="{Binding HasData}" MinHeight="220" Margin="0,8,0,0"
                                AutomationProperties.Name="Time per activity over the range. Use the arrow keys to read each point." />
        </DockPanel>
      </TabItem>
    </TabControl>
  </DockPanel>
</Window>
