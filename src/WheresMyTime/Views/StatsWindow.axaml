<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:WheresMyTime.ViewModels"
        xmlns:views="using:WheresMyTime.Views"
        x:Class="WheresMyTime.Views.StatsWindow"
        x:DataType="vm:StatsViewModel"
        Title="Stats — Where's my time"
        Width="640" Height="760" MinWidth="440" MinHeight="460"
        WindowStartupLocation="CenterScreen">
  <Window.Styles>
    <!-- Legend entries: compact chips; the highlighted one fills, the others fade. -->
    <Style Selector="Button.legend">
      <Setter Property="MinHeight" Value="32" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="Foreground" Value="{DynamicResource OnSurface}" />
    </Style>
    <Style Selector="Button.legend:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource OnSurfaceStateHover}" />
    </Style>
    <Style Selector="Button.legend:pressed /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource OnSurfaceStatePressed}" />
    </Style>
    <Style Selector="Button.legend.active">
      <Setter Property="Background" Value="{DynamicResource SecondaryContainer}" />
      <Setter Property="Foreground" Value="{DynamicResource OnSecondaryContainer}" />
    </Style>
    <Style Selector="Button.legend.active:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{DynamicResource SecondaryContainerHover}" />
    </Style>
    <Style Selector="Button.legend.active TextBlock.name">
      <Setter Property="FontWeight" Value="Medium" />
    </Style>
    <Style Selector="Button.legend.dimmed">
      <Setter Property="Opacity" Value="0.5" />
    </Style>
  </Window.Styles>

  <Window.Resources>
    <!-- Legend shared by both charts; clicking an entry highlights that activity. -->
    <ItemsPanelTemplate x:Key="LegendPanel">
      <WrapPanel ItemSpacing="4" LineSpacing="4" />
    </ItemsPanelTemplate>
    <DataTemplate x:Key="LegendItemTemplate" x:DataType="vm:LegendItem">
      <Button Classes="legend" Classes.active="{Binding IsActive}" Classes.dimmed="{Binding IsDimmed}"
              Command="{Binding $parent[Window].((vm:StatsViewModel)DataContext).ToggleHighlightCommand}"
              CommandParameter="{Binding}" ToolTip.Tip="Click to highlight">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <views:SeriesSwatch Slot="{Binding Slot}" Width="12" Height="12" VerticalAlignment="Center" />
          <TextBlock Classes="body-small name" Text="{Binding Name}" VerticalAlignment="Center" />
          <TextBlock Classes="body-small muted tabular" Text="{Binding TotalText}" VerticalAlignment="Center" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </Window.Resources>

  <Grid>
    <DockPanel Margin="24,20,24,16">

      <!-- The date range scopes every tab. -->
      <StackPanel DockPanel.Dock="Top" Spacing="16">
        <ItemsControl ItemsSource="{Binding Presets}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel ItemSpacing="8" LineSpacing="8" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:PresetChip">
              <Button Classes="chip" Classes.selected="{Binding IsSelected}"
                      Command="{Binding $parent[Window].((vm:StatsViewModel)DataContext).PresetCommand}"
                      CommandParameter="{Binding Key}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <Path Classes="icon" Data="{StaticResource IconCheck}" Width="18" Height="18" IsVisible="{Binding IsSelected}" />
                  <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Orientation="Horizontal" Spacing="12">
          <CalendarDatePicker SelectedDate="{Binding From}" Width="170" PlaceholderText="From"
                              SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
          <CalendarDatePicker SelectedDate="{Binding To}" Width="170" PlaceholderText="To"
                              SelectedDateFormat="Custom" CustomDateFormatString="yyyy-MM-dd" />
        </StackPanel>

        <Grid ColumnDefinitions="*,Auto">
          <StackPanel>
            <TextBlock Classes="headline" Text="{Binding TotalText}" />
            <TextBlock Classes="muted" Text="{Binding SummaryText}" TextWrapping="Wrap" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <Button Classes="outlined" Content="Copy" Command="{Binding CopyCommand}" ToolTip.Tip="Copy the stats as text" />
            <Button Classes="outlined" Content="Export CSV" Command="{Binding ExportCommand}"
                    ToolTip.Tip="Save the entries in this range as CSV" />
          </StackPanel>
        </Grid>
      </StackPanel>

      <TabControl Margin="0,8,0,0" Padding="0">

        <TabItem Header="Summary">
          <DockPanel Margin="0,12,0,0">
            <CheckBox DockPanel.Dock="Top" Content="Show details" IsChecked="{Binding ShowDetails}"
                      HorizontalAlignment="Right" IsVisible="{Binding HasData}" />
            <ScrollViewer Margin="0,4,0,0">
              <!-- Right margin keeps the percentages clear of the scrollbar. -->
              <StackPanel Spacing="24" Margin="0,0,16,0">
                <TextBlock Classes="muted" Text="No entries in this range." IsVisible="{Binding !HasData}"
                           HorizontalAlignment="Center" Margin="0,20" />

                <ItemsControl ItemsSource="{Binding Activities}">
                  <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                      <StackPanel Spacing="16" />
                    </ItemsPanelTemplate>
                  </ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:ActivityRow">
                      <StackPanel Spacing="6">
                        <Grid ColumnDefinitions="*,Auto,64">
                          <TextBlock Classes="title-small" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                          <TextBlock Grid.Column="1" Classes="tabular" Text="{Binding TotalText}" />
                          <TextBlock Grid.Column="2" Classes="muted tabular" Text="{Binding PercentText}" TextAlignment="Right" />
                        </Grid>
                        <ProgressBar Value="{Binding Percent}" Maximum="100" />
                        <ItemsControl ItemsSource="{Binding Details}" Margin="16,2,0,0"
                                      IsVisible="{Binding $parent[Window].((vm:StatsViewModel)DataContext).ShowDetails}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:DetailRow">
                              <Grid ColumnDefinitions="*,Auto,64">
                                <TextBlock Classes="body-small muted" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Classes="body-small muted tabular" Text="{Binding TotalText}" />
                              </Grid>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <StackPanel Spacing="8" IsVisible="{Binding HasData}">
                  <TextBlock Classes="title" Text="By day" />
                  <ItemsControl ItemsSource="{Binding Days}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Spacing="8" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DayRow">
                        <Grid ColumnDefinitions="130,*,70">
                          <TextBlock Classes="tabular" Text="{Binding Label}" VerticalAlignment="Center" />
                          <ProgressBar Grid.Column="1" Value="{Binding Percent}" Maximum="100" VerticalAlignment="Center" />
                          <TextBlock Grid.Column="2" Classes="tabular" Text="{Binding TotalText}" TextAlignment="Right" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </StackPanel>
            </ScrollViewer>
          </DockPanel>
        </TabItem>

        <TabItem Header="Breakdown">
          <DockPanel Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Top" Classes="title" Text="{Binding ChartTitle}" IsVisible="{Binding HasData}" />
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Legend}" IsVisible="{Binding HasLegend}" Margin="0,8,0,4"
                          ItemsPanel="{StaticResource LegendPanel}" ItemTemplate="{StaticResource LegendItemTemplate}" />
            <TextBlock DockPanel.Dock="Top" Classes="muted" Text="No entries in this range." IsVisible="{Binding !HasData}"
                       HorizontalAlignment="Center" Margin="0,20" />
            <views:StackedColumnChart Data="{Binding Chart}" Highlighted="{Binding Highlighted, Mode=TwoWay}"
                                      IsVisible="{Binding HasData}" MinHeight="220" Margin="0,8,0,0"
                                      AutomationProperties.Name="Time per day by activity. Use the arrow keys to read each column." />
          </DockPanel>
        </TabItem>

        <TabItem Header="Trend">
          <DockPanel Margin="0,16,0,0">
            <TextBlock DockPanel.Dock="Top" Classes="title" Text="{Binding TrendTitle}" IsVisible="{Binding HasData}" />
            <TextBlock DockPanel.Dock="Top" Classes="body-small muted" Text="{Binding TrendHint}" IsVisible="{Binding HasLegend}"
                       TextWrapping="Wrap" Margin="0,4,0,0" />
            <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Legend}" IsVisible="{Binding HasLegend}" Margin="0,8,0,4"
                          ItemsPanel="{StaticResource LegendPanel}" ItemTemplate="{StaticResource LegendItemTemplate}" />
            <TextBlock DockPanel.Dock="Top" Classes="muted" Text="No entries in this range." IsVisible="{Binding !HasData}"
                       HorizontalAlignment="Center" Margin="0,20" />
            <views:TrendLineChart Data="{Binding Chart}" Highlighted="{Binding Highlighted, Mode=TwoWay}"
                                  IsVisible="{Binding HasData}" MinHeight="220" Margin="0,8,0,0"
                                  AutomationProperties.Name="Time per activity over the range. Use the arrow keys to read each point." />
          </DockPanel>
        </TabItem>
      </TabControl>
    </DockPanel>

    <Border Classes="snackbar" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="16,0,16,24"
            IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
      <TextBlock Text="{Binding StatusText}" />
    </Border>
  </Grid>
</Window>
